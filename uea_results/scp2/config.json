{
  "dataset": {
    "file": "data/selfregulationscp2_walker/splits/selfregulationscp2_walker_seed0.npz"
  },
  "preprocessing": {
    "dtype": "float32",
    "path": {
      "representation": "value",
      "derivative_order": 0,
      "derivative_window": 15,
      "derivative_polyorder": 3,
      "normalize": true,
      "normalize_mode": "all_data",
      "normalize_range": "[-1,1]",
      "per_sample_normalize": false,
      "per_sample_norm_stat": "std",
      "basepoint": false,
      "clock_channel": null
    },
    "clock": {
      "mode": "blended_quad_variation",
      "alpha": 0.6124882756267624,
      "scaling": "[-1,1]"
    }
  },
  "model": {
    "A": {
      "parametrization": "skew_symmetric",
      "learn": true,
      "init": {
        "type": "skew_symmetric",
        "mean": 0.0,
        "variance": 0.006
      }
    },
    "B": {
      "enabled": true,
      "out_dim": 14,
      "_preserve_first_channel": false,
      "parametrization": "general",
      "init": {
        "type": "identity_block",
        "mean": 0.0,
        "variance": 1.0
      },
      "learn": true
    },
    "head_type": "linear",
    "head_init_scale": 0.06,
    "readout": "terminal",
    "feature_norm": "learned_gain",
    "head_hidden_dims": [
      64
    ],
    "compute": {
      "van_loan_expm": "euler",
      "chen_expm": "cayley",
      "M": 4,
      "terminal_reduce": "tree",
      "reweighting_mode": "displacement_uniform"
    },
    "depth": 3
  },
  "training": {
    "seed": 42,
    "batch_size": 8,
    "num_steps": 25000,
    "eval_every": 1000,
    "log_every": 1200,
    "warmup_steps": 0,
    "lr_features": 0.0005,
    "min_lr_features": 0.0005,
    "lr_head": 0.0005,
    "min_lr_head": 0.0005,
    "weight_decay_features": 0.0,
    "weight_decay_head": 0.0,
    "grad_clip_features": 1000000000.0,
    "grad_clip_head": 1000000000.0,
    "lambda1": 0.0,
    "lambda2": 0.03,
    "label_smoothing": 0.0,
    "metric": "accuracy",
    "threshold": 0.5,
    "early_stopping_patience": 10000,
    "early_stopping_min_delta": 0.0
  }
}