      "derivative_polyorder": 3,
      "normalize": true,
      "normalize_mode": "all_data",
      "normalize_range": "[-1,1]",
      "per_sample_normalize": false,
      "per_sample_norm_stat": "std",
      "basepoint": true,
      "clock_channel": null
    },
    "clock": {
      "mode": "time",
      "scaling": "steps"
    },
    "append_clock": null
  },
  "model": {
    "A": {
      "parametrization": "damped_rotation",
      "learn": true,
      "init": {
        "type": "sig",
        "mean": 0.0,
        "variance": 0.013664354731808851,
        "sigma_range": 0.9228327328240815
      },
      "omega_scale": 0.2,
      "damp_init_mean": -2.0,
      "damp_init_std": 1.7115404791047912,
      "blocks": [
        2,
        2,
        2,
        2,
        2,
        2,
        2,
        2,
        2,
        2,
        2,
        2
      ]
    },
    "B": {
      "enabled": true,
      "out_dim": 24,
      "_preserve_first_channel": false,
      "parametrization": "general",
      "init": {
        "type": "identity_block",
        "mean": 0.0,
