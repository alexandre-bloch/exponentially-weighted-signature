{
  "dataset": {
    "file": "data/sde_a/sde_a_seed0.npz"
  },
  "preprocessing": {
    "dtype": "float32",
    "normalize_targets": true,
    "target_range": "[0,1]",
    "path": {
      "representation": "value",
      "derivative_order": 0,
      "derivative_window": 15,
      "derivative_polyorder": 3,
      "normalize": true,
      "normalize_mode": "train_only",
      "normalize_range": "[0,1]",
      "per_sample_normalize": false,
      "per_sample_norm_stat": "std",
      "basepoint": true,
      "clock_channel": "main"
    },
    "clock": {
      "mode": "time"
    }
  },
  "model": {
    "A": {
      "parametrization": "general",
      "init": {
        "type": "sig"
      },
      "learn": true
    },
    "B": {
      "enabled": false
    },
    "head_type": "linear",
    "head_init_scale": 0.0025414027723199366,
    "compute": {
      "van_loan_expm": "exact",
      "chen_expm": "exact",
      "M": 10,
      "reweighting_mode": "displacement_uniform_basepoint"
    },
    "depth": 2
  },
  "training": {
    "seed": 100,
    "batch_size": 32,
    "num_steps": 15000,
    "eval_every": 500,
    "log_every": 500,
    "warmup_steps": 500,
    "lr_features": 0.24198984142779664,
    "min_lr_features": 0.0004454637787728168,
    "lr_head": 0.04277724924974193,
    "min_lr_head": 7.728259639964213e-05,
    "weight_decay_features": 3.6203304971058434e-06,
    "weight_decay_head": 0.00022037923438149006,
    "grad_clip_features": 616.6965030709438,
    "grad_clip_head": 18115.81709178953,
    "lambda1": 1.6521060871222108e-05,
    "lambda2": 6.271724395082683e-06,
    "early_stopping_patience": 0
  }
}