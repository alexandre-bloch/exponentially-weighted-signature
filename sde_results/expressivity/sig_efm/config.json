{
  "dataset": {
    "file": "data/sde_d/sde_d_Sig_seed0.npz"
  },
  "preprocessing": {
    "dtype": "float32",
    "normalize_targets": true,
    "target_range": "[0,1]",
    "path": {
      "representation": "value",
      "derivative_order": 0,
      "derivative_window": 15,
      "derivative_polyorder": 3,
      "normalize": false,
      "normalize_mode": "train_only",
      "normalize_range": "[0,1]",
      "per_sample_normalize": false,
      "per_sample_norm_stat": "std",
      "basepoint": false,
