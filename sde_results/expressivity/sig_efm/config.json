      "mode": "time",
      "scaling": "none"
    }
  },
  "model": {
    "A": {
      "parametrization": "efm",
      "positivity": "square",
      "init": {
        "type": "efm",
        "mean": 0.0,
        "variance": 1.0
      },
      "learn": true
    },
    "B": {
      "enabled": false
    },
    "head_type": "linear",
    "head_init_scale": 0.0036435262978797775,
    "compute": {
      "van_loan_expm": "exact",
      "chen_expm": "exact",
      "M": 10,
      "reweighting_mode": "displacement_uniform"
