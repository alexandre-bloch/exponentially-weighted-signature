  "training": {
    "seed": 100,
    "batch_size": 32,
    "num_steps": 30000,
    "eval_every": 500,
    "log_every": 500,
    "warmup_steps": 500,
    "lr_features": 0.031257088727598706,
    "min_lr_features": 0.0007303998273236134,
    "lr_head": 0.0011002137343162893,
    "min_lr_head": 1.315005175234239e-06,
    "weight_decay_features": 0.00019882474680351636,
    "weight_decay_head": 0.008027117116608945,
    "grad_clip_features": 81023.56207766633,
    "grad_clip_head": 5838.8911122215195,
    "lambda1": 2.442728047335308e-05,
    "lambda2": 0.009320745757067903,
    "early_stopping_patience": 0
  }
