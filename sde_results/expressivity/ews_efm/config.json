    "weight_decay_head": 0.0005994629366520189,
    "grad_clip_features": 9370.686974300705,
    "grad_clip_head": 185619.0455328803,
    "lambda1": 0.0313901708183825,
    "lambda2": 0.0026557139660485607,
    "early_stopping_patience": 0
  }
